---
import { career } from '../data/career';

const chronological = [...career].reverse();
---
<div class="career-map" role="group" aria-labelledby="career-map-title">
  <div class="career-map__intro">
    <p class="eyebrow">Career map</p>
    <p id="career-map-title" class="career-map__summary">
      게임 서비스 운영과 콘텐츠 기획을 거쳐 지금은 사업 PM으로 일합니다.
    </p>
  </div>

  <ol class="career-map__route" aria-label="경력 흐름">
    {
      chronological.map((item, index) => (
        <li class="career-map__stop">
          <div class="career-map__station" aria-hidden="true">
            <span class="career-map__station-number">{String(index + 1).padStart(2, '0')}</span>
            <span class="career-map__station-dot" />
          </div>

          <div class="career-map__visual" aria-hidden="true">
            <span>{item.title.replace('게임 ', '').replace('콘텐츠 ', '').replace('와 운영', '')}</span>
          </div>

          <div class="career-map__content">
            <div class="career-map__time">
              <span>{item.start}</span>
              {item.end && <span> — {item.end}</span>}
            </div>
            <h3>{item.title}</h3>
            {item.organization && <p class="career-map__organization">{item.organization}</p>}
            {item.description && <p>{item.description}</p>}
            {item.href && <a href={item.href}>관련 글 →</a>}
          </div>
        </li>
      ))
    }
  </ol>
</div>
