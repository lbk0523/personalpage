---
import type { CollectionEntry } from 'astro:content';

type Props = {
  entries: CollectionEntry<'writing'>[];
};

const { entries } = Astro.props;
const formatter = new Intl.DateTimeFormat('ko-KR', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
---
{entries.length > 0 && (
  <ul class="writing-list">
    {
      entries.map((entry) => (
        <li>
          <a class="writing-drawer" href={`/writing/${entry.id}/`}>
            <time datetime={entry.data.publishedAt.toISOString()}>{formatter.format(entry.data.publishedAt)}</time>
            <h2>{entry.data.title}</h2>
            <span class="writing-drawer__handle" aria-hidden="true"></span>
          </a>
        </li>
      ))
    }
  </ul>
)}
