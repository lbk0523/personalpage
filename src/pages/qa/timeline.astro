---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CareerTimeline from '../../components/CareerTimeline.astro';
import { career } from '../../data/career';
---

<BaseLayout title="Career Timeline QA" description="구현 단계의 임시 Career Timeline 시각 비교 화면입니다.">
  <div class="qa-wrap">
    <header class="qa-intro">
      <p class="eyebrow">Implementation QA</p>
      <h1>걸어온 길 시각화 비교</h1>
      <p class="lead">정보 구조는 같게 두고, 이력서처럼 딱딱하지 않으면서 경력의 흐름이 보이는 표현을 비교합니다.</p>
    </header>

    <section class="qa-section">
      <div class="qa-label">
        <span>A</span>
        <div>
          <h2>연결선형</h2>
          <p>시간의 연속성을 직접 보여주는 현재 구현.</p>
        </div>
      </div>
      <CareerTimeline />
    </section>

    <section class="qa-section">
      <div class="qa-label">
        <span>B</span>
        <div>
          <h2>챕터형</h2>
          <p>연도를 큰 장면 전환처럼 사용해 개인적인 경력 서사에 가까운 리듬을 만듭니다.</p>
        </div>
      </div>
      <ol class="chapter-timeline" aria-label="경력 흐름 — 챕터형 시안">
        {career.map((item, index) => (
          <li class="chapter-timeline__item">
            <div class="chapter-timeline__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</div>
            <div class="chapter-timeline__time">
              <span>{item.start}</span>
              {item.end && <span>— {item.end}</span>}
            </div>
            <div class="chapter-timeline__content">
              <h3>{item.title}</h3>
              {item.organization && <p class="chapter-timeline__organization">{item.organization}</p>}
              {item.description && <p>{item.description}</p>}
              {item.href && <a href={item.href}>관련 기록 보기 →</a>}
            </div>
          </li>
        ))}
      </ol>
    </section>
  </div>
</BaseLayout>

<style>
  .qa-wrap { max-width: 900px; margin-inline: auto; }
  .qa-intro { margin-bottom: 5rem; }
  .qa-section { padding: 3.5rem 0; border-top: 1px solid var(--color-border); }
  .qa-label { display: grid; grid-template-columns: 48px 1fr; gap: 1rem; margin-bottom: 3rem; }
  .qa-label > span { font-size: 0.78rem; color: var(--color-muted); letter-spacing: 0.08em; }
  .qa-label h2 { margin-bottom: 0.35rem; }
  .qa-label p { margin: 0; color: var(--color-muted); }

  .chapter-timeline { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--color-border); }
  .chapter-timeline__item {
    display: grid;
    grid-template-columns: 56px minmax(170px, 0.42fr) 1fr;
    gap: 1.4rem;
    padding: 2.2rem 0 2.6rem;
    border-bottom: 1px solid var(--color-border);
  }
  .chapter-timeline__number {
    padding-top: 0.55rem;
    color: var(--color-muted);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
  }
  .chapter-timeline__time {
    font-size: clamp(2.1rem, 5vw, 4rem);
    font-weight: 650;
    line-height: 0.98;
    letter-spacing: -0.07em;
    color: #c5c5bf;
  }
  .chapter-timeline__time span { display: block; }
  .chapter-timeline__time span + span { margin-top: 0.35rem; font-size: 0.34em; letter-spacing: -0.03em; color: var(--color-muted); }
  .chapter-timeline__content { padding-top: 0.3rem; }
  .chapter-timeline__content h3 { font-size: clamp(1.25rem, 2.5vw, 1.65rem); margin-bottom: 0.45rem; }
  .chapter-timeline__content p { max-width: 520px; color: var(--color-muted); }
  .chapter-timeline__organization { margin-bottom: 0.45rem; font-size: 0.9rem; }

  @media (max-width: 760px) {
    .qa-intro { margin-bottom: 3rem; }
    .qa-section { padding: 2.5rem 0; }
    .qa-label { margin-bottom: 2rem; }
    .chapter-timeline__item { grid-template-columns: 32px 1fr; gap: 0.8rem 1rem; padding: 1.8rem 0 2rem; }
    .chapter-timeline__number { grid-row: 1 / span 2; }
    .chapter-timeline__time { grid-column: 2; font-size: clamp(2rem, 12vw, 3rem); }
    .chapter-timeline__content { grid-column: 2; }
  }
</style>
