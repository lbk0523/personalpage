---
import { getCollection } from 'astro:content';
import WritingList from '../components/WritingList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';

const entries = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
---
<BaseLayout>
  <section class="home-intro">
    <h1>생각이 남을 때 씁니다.</h1>
    <p class="lead">{profile.intro}</p>
    <p class="lead">{profile.archiveNote}</p>
  </section>

  {entries.length > 0 && (
    <section class="archive" aria-labelledby="archive-title">
      <h2 id="archive-title">쓴 글</h2>
      <WritingList entries={entries} />
    </section>
  )}
</BaseLayout>
